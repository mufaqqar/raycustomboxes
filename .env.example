# WordPress / WooGraphQL
# GraphQL endpoint exposed by WPGraphQL (and WPGraphQL for WooCommerce).
WORDPRESS_API_URL=https://cms.example.com/graphql

# Optional: full Authorization header value for a protected endpoint.
# e.g. "Basic base64(user:application-password)" or "Bearer <jwt>"
WORDPRESS_AUTH_HEADER=

# Optional: extra image hosts (CDN / S3 offload), comma separated.
WORDPRESS_IMAGE_HOSTS=

# Optional: WordPress site URL used only to whitelist image hosts.
WORDPRESS_SITE_URL=

# Secret required by POST /api/revalidate
WORDPRESS_REVALIDATE_SECRET=change-me
